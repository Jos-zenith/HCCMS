# ---- Web app ----
# PostgreSQL connection string (Supabase, Neon, Railway, RDS...). Required on
# serverless hosts such as Vercel. If unset, an embedded PGlite database is
# stored on disk in PGLITE_DIR (single long-running server only).
DATABASE_URL=
PGLITE_DIR=.data/pglite
# DATABASE_SSL=false        # for a local Postgres without TLS

# Time zone used for daily carbon accounting
APP_TIMEZONE=Asia/Kolkata

# Inference server base URL (inference/inference_server.py). Without it, species
# identification and leaf-health analysis return 503.
INFERENCE_URL=http://localhost:5000

# Grid emission factor, kg CO2 per kWh (default: CEA Indian grid average 0.716)
NEXT_PUBLIC_GRID_EF_KG_PER_KWH=0.716


# ---- Inference server ----
MODEL_PATH=victori/best_resnet50.pth
# URL to download the checkpoint from at startup when MODEL_PATH is missing
MODEL_URL=
